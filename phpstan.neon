includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - config/
        - database/
        - routes/

    # Level 8 menangkap nilai null yang bisa berujung galat 500. Level 9–10 tidak dipakai (pilihan pemilik):
    # keduanya menuntut tipe rinci untuk setiap nilai mixed (config, input, atribut model) dengan manfaat kecil.
    level: 8

    # Model memakai method casts() (CLAUDE.md §8); tanpa ini Larastan hanya membaca tipe kolom migration,
    # sehingga atribut ber-cast enum dianggap string.
    parseModelCastsMethod: true
